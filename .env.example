# Copy to `.env` and fill in values. Never commit `.env`.

# Supabase (browser + SSR; use the anon / publishable key, not the service role)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# Auth: enable Email, Google, and GitHub in Supabase Dashboard → Authentication → Providers.
# Add redirect URL: http://localhost:5173/auth/callback (and your production URL).
# Apply migration: supabase/migrations/20260716120000_auth_personalization.sql

# Mapbox public access token (globe map)
VITE_MAPBOX_TOKEN=your_mapbox_public_token

# OpenWeatherMap API key (current weather) — server-only, read by
# `/api/public/openweather-proxy`. The key never reaches the browser bundle.
# (A `VITE_OPENWEATHER_API_KEY` value also still works as a fallback for
# existing setups, but prefer this unprefixed name for new deployments.)
OPENWEATHER_API_KEY=your_openweather_api_key

# GNews API key — server-only, read by `/api/public/gnews-proxy`.
# Do NOT use VITE_GNEWS_API_KEY — Vite exposes all VITE_* vars to the browser bundle.
GNEWS_API_KEY=your_gnews_api_key

# Global Pulse AI — server-only (POST /api/ai-news-chat → Google Gemini). Never use VITE_GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
# After editing .env: stop dev server (Ctrl+C) and run `npm run dev` again.

# --- Vercel deploy ---
# In Vercel → Project → Settings → Environment Variables, add the same keys
# (VITE_* for client, GEMINI_*/GNEWS_*/etc. for server). Framework preset:
# "TanStack Start" (vercel.json already sets framework: tanstack-start).
# Do not set Output Directory manually — Nitro writes .vercel/output.

# Deprecated (removed): AI_API_KEY, AI_MODEL, OPENAI_API_KEY — use GEMINI_* instead.

# ACLED conflict data — server-only credentials (never VITE_*), used by /api/acled/events
ACLED_USERNAME=your_acled_account_email
ACLED_PASSWORD=your_acled_account_password

# NASA FIRMS active fire data — server-only, free registration at
# https://firms.modaps.eosdis.nasa.gov/api/ . Optional: the Wildfires map
# layer and FIRMS provider are disabled gracefully when unset.
FIRMS_MAP_KEY=your_firms_map_key

# GDACS, GDELT, and the trusted-broadcaster RSS aggregator need no API keys
# — their proxies (/api/public/gdacs-proxy, gdelt-proxy, rss-proxy) work out
# of the box.

# ReliefWeb (UN OCHA) humanitarian crisis data — server-only. Since 1 Nov 2025
# the API requires a pre-approved appname (free — request one at
# https://apidoc.reliefweb.int/parameters#appname). Optional: the
# Humanitarian Crises map layer and ReliefWeb provider are disabled
# gracefully when unset.
RELIEFWEB_APPNAME=your_approved_reliefweb_appname

# REST Countries v5 — server-only, used by /api/public/restcountries-proxy.
# Legacy v3.1 was shut down; v5 requires a free API key from
# https://restcountries.com/sign-up . Without this key the app uses bundled
# reference data for 50 countries (Romania, Germany, USA, etc.) so search
# and compare never break during demos.
REST_COUNTRIES_API_KEY=your_rest_countries_v5_api_key
