# Copy to `.env` and fill in values. Never commit `.env`.

# Supabase (browser + SSR; use the anon / publishable key, not the service role)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# Mapbox public access token (globe map)
VITE_MAPBOX_TOKEN=your_mapbox_public_token

# OpenWeatherMap API key (current weather)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# GNews API key — read by the server route `/api/public/gnews-proxy` (Vite injects `VITE_*` into the worker build; optional duplicate: `GNEWS_API_KEY` for non-Vite deploys)
VITE_GNEWS_API_KEY=your_gnews_api_key

# Global Pulse AI — server-only (POST /api/ai-news-chat → Google Gemini). Never use VITE_GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.0-flash-lite
# After editing .env: stop dev server (Ctrl+C) and run `npm run dev` again.

# Deprecated (removed): AI_API_KEY, AI_MODEL, OPENAI_API_KEY — use GEMINI_* instead.
